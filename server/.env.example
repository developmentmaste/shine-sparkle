# Copy this file to .env and fill in your own values.

PORT=4000

# Origin of your React app, used for CORS. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection. Either set DATABASE_URL, or the individual PG_* vars below.
# Works with any hosted Postgres (Railway, Supabase, Neon, RDS, local, etc).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shine_sparkle

# Used only if DATABASE_URL is not set
PGHOST=localhost
PGPORT=5432
PGDATABASE=shine_sparkle
PGUSER=postgres
PGPASSWORD=postgres

# Set to "true" if your DB provider requires SSL (most hosted providers do)
PGSSL=false
